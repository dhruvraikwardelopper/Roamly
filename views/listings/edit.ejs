<% layout('./layouts/boilerplate.ejs') %>

<body>
  
  <div class="row ">
    <div class="col-8 offset-2">
      <h4 class="fw-light">
        You are editing this listing : <b class="fst-italic fw-semibold fs-3"><%= listing.title %></b>
      </h4>
      <br />
      <form method="post" action="/listings/<%= listing._id  %>?_method=PUT">
        <div class="mb-3">
          <label for="title" class="form-label">Title : </label>
          <input
            type="text"
            name="listing[title]"
            class="form-control"
            value="<%= listing.title  %>"
          />
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description : </label>
          <textarea name="listing[description]" class="form-control">
            <%= listing.description  %></textarea>
        </div>
        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="price" class="form-label">Price : </label>
            <input
              type="number"
              name="listing[price]"
              class="form-control"
              placeholder="Ex- 1200"
              value="<%= listing.price  %>"
            />
          </div>
          <div class="col-md-8 mb-3">
            <label for="country" class="form-label">Country : </label>
            <input
              type="text"
              name="listing[country]"
              class="form-control"
              placeholder="Ex- India"
              value="<%= listing.country  %>"
            />
          </div>
        </div>
        <div class="mb-3">
          <label for="image" class="form-label">Image : </label>
          <input
            type="text"
            name="listing[image]"
            class="form-control"
            placeholder="Enter Image URL/Link"
            value="<%= listing.image  %>"
          />
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location : </label>
          <input
            type="text"
            name="listing[location]"
            class="form-control"
            placeholder="Ex- Banda"
            value="<%= listing.location  %>"
          />
        </div>
        <br />
        <br />
        <div class="btn-add-p">
          <button type="submit" class="btn btn-success edit-btn">
            Edit Listing
          </button>
        </div>
      </form>
    </div>
  </div>
</body>
