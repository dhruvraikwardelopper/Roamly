<% layout('./layouts/boilerplate.ejs') %>

  <body>
    <div class="row">
      <div class="col-8 offset-2 text-center">
        <h2>Listing Detail:
          <b><i>
              <%= listing.title %>
            </i></b>

        </h2>
      </div>
      <div class="col-6 offset-3">
        <div class="card listing-card">
          <img src="<%= listing.image  %>" class="card-img-top show-img" alt="img" />
          <div class="card-body">
            <p class="card-text">
              <b class="fs-4 fw-semibold">
                <%= listing.title %>
              </b><br />
              <span>
                <%= listing.description %>
              </span>
              <br>
              <span class="fst-italic">
                &#8377; <%= listing.price.toLocaleString('en-IN') %>/night
              </span> <br />
              <span class="fw-lighter">
                <%= listing.location %> ,<%= listing.country %>
            </p>
            </span>
          </div>
        </div>

        <div class="btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-2  edit-btn">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark margin-right-3">Delete</button>
          </form>
        </div>
      </div>
      <div class="row">
        <div class="col offset-2 col-8">
          <h4> Rate this Listing</h4>
          <form class="mt-3 mb-3 needs-validation " method="post" action="/listings/<%= listing._id %>/reviews"
            novalidate>
            <div class="mb-3">
              <label class="form-label" for="rating">Rating</label>
              <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]">
            </div>
            <div class="mb-3">
              <label class="form-label" for="comment">Comment</label>
              <textarea class="form-control" name="review[comment]" id="comment" required></textarea>
              <div class="invalid-feedback">Please leave a comment</div>
            </div>
            <button class="btn btn-outline-dark">Add Rating</button>
          </form>

        </div>
      </div>
      <hr />
      <div class="row">
        <div class=" offset-2 col-8">
          <h1> All Review</h1>
          <!-- Review  Section  -->
          <div class="row offset-1">
            <% for(review of listing.reviews) {%>
              <div class="card  col-5 ms-3 ">
                <div class="card-body">
                  <h5 class="user">jon dee</h5>
                  <p class="card-text">
                    <%= review.comment %>
                  </p>
                  <p class="card-text">
                    <%=review.rating %> Stars
                  </p>
                </div>
                <form class="mb-3" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class=" btn btn-dark">Delete this Review</button>
                </form>
              </div>


              <% } %>
          </div>
        </div>
      </div>
    </div>
  </body>