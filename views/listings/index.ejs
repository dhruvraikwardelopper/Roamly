<% layout('./layouts/boilerplate.ejs') %>


    <div class="row align-items-center">

        <!-- Left side: Slider -->
        <div class="col-8 ">
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">

                    <div class="filter swiper-slide ">
                        <div class=""><i class="fa-solid fa-fire"></i></div>
                        <p>Trending</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-bed"></i></div>
                        <p>Room</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-mountain-city"></i></div>
                        <p>Iconic-Cities</p>
                    </div>
                    <div class="filter swiper-slide ">
                        <div class=""><i class="fa-regular fa-snowflake"></i></div>
                        <p>Snow</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-mountain-sun"></i></div>
                        <p>Mountain</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-brands fa-fort-awesome"></i></div>
                        <p>Castles</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-cow"></i></div>
                        <p>Farms</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-campground"></i></div>
                        <p>Camping</p>
                    </div>
                    

                     <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-ship"></i></div>
                        <p>Boat</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-igloo"></i></div>
                        <p>winter</p>
                    </div>

                     <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-bed"></i></div>
                        <p>Room</p>
                    </div>

                    <div class="filter swiper-slide">
                        <div><i class="fa-solid fa-kitchen-set"></i></div>
                        <p>Best-food</p>
                    </div>



                </div>

                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>

        <!-- Right side: Other content -->
        <div class="col-4">
            <!-- Your other content -->
            <div class="text-end ">
                <div class="form-check form-switch form-check-reverse">
                    <input class="form-check-input" type="checkbox" id="switchCheckReverse">
                    <label class="form-check-label" for="switchCheckReverse">Display totle after taxes</label>
                </div>
            </div>
        </div>

    </div>





    <div class="row row-cols-lg-3 row-cols-md-2">
        <% for(let listing of listings){ %>
            <a href="/listings/<%= listing._id %>" class="listing-link">

                <div class="card listing-card col listing-card">
                    <div class="image-container">
                        <img src="<%= listing.image.url %>" class="card-img-top listing-image" alt="img">
                    </div>
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <h5 class="card-title">
                            <p>
                                <span>
                                    <%= listing.title %>
                                </span><br />
                                <span class="fs-6 fw-light">
                                    &#8377; <%= listing.price.toLocaleString('en-IN') %>/night
                                        <i class="tax-info">+18% GST </i>
                                </span>
                            </p>
                        </h5>

                    </div>
                </div>
            </a>

            <% } %>
                <script src="https://cdn.jsdelivr.net/npm/swiper@14.0.1/swiper-bundle.min.js"></script>
                <script src="/js/swiper.js"></script>
                <script>
                    let taxToggle = document.querySelector("#switchCheckReverse")
                    taxToggle.addEventListener("click", () => {
                        console.log("clicked")
                        let taxInfo = document.querySelectorAll(".tax-info")
                        for (info of taxInfo) {
                            if (info.style.display != "inline") {
                                info.style.display = "inline"
                            } else {
                                info.style.display = "none"
                            }
                        }
                    })
                </script>
    </div>