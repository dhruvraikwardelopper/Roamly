<% layout('./layouts/boilerplate.ejs') %>

<div class="row">
  <div class="col-8 offset-2">
    <h3 class="text-center"><u>Create new listing </u></h3>
    <br />
    <form method="post" class="needs-validation" action="/listings" novalidate>
      <div class="mb-3">
        <label for="title" class="form-label">Title : </label>
        <input
          type="text"
          name="listing[title]"
          class="form-control"
          placeholder="Enter Cripy title"
          required
        />
        <div class="invalid-feedback">
          Please Enter a title
        </div>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description : </label>
        <textarea name="listing[description]" class="form-control" 
          required
         ></textarea>
          <div class="invalid-feedback">
          Please Enter a Description
        </div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label for="price" class="form-label">Price : </label>
          <input
            name="listing[price]"
            class="form-control"
            placeholder="Ex- 1200"
            required
          />
           <div class="invalid-feedback">
          Please enter a vaild price
        </div>
        </div>
        <div class="col-md-8 mb-3">
          <label for="country" class="form-label">Country : </label>
          <input
            type="text"
            name="listing[country]"
            class="form-control"
            placeholder="Ex- India"
          required

          />
           <div class="invalid-feedback">
          Please enter a country
        </div>
      </div>

        </div>
          <div class="mb-3">
        <label for="image" class="form-label">Image : </label>
        <input
          type="text"
          name="listing[image]"
          class="form-control"
          placeholder="Enter Image URL/Link"

        />
         <div class="invalid-feedback">
         Enter a vaild URL
        </div>
      </div>
       <div class="mb-3">
        <label for="location" class="form-label">Location : </label>
        <input
          type="text"
          name="listing[location]"
          class="form-control"
          placeholder="Ex- Banda"
          required

        />
         <div class="invalid-feedback">
          Please Enter a vaild Location
        </div>
      </div>
        
    
     
      <br />
      <br />
   
        <button type="submit" class="btn btn-success add-btn">
          Add New Listing
        </button>
     
    </form>
  </div>
</div>


