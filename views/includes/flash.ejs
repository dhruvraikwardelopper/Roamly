<% if(msg&&msg.length){ %><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

   <div class="alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3 w-25" role="alert" style="z-index: 1055;">
    <%= msg  %>
  
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
</body>
</html><% } %>

<% if(error && error.length)
  { %><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

   <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 m-3 w-25" role="alert" style="z-index: 1055;">
 
    <%= error  %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
</body>
</html><% } %>