<% layout('./layouts/boilerplate.ejs') %>
<div class="row">
  <div class="col-6 offset-3">
    <div class="card mb-4">
       <div class="card-text">
        <h4 class="text-center mt-4">SignUp </h4>
       </div> 
      <form method="post" action="/signup" class="needs-validation card-body" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username : </label>
          <input
            type="text"
            name="username"
            class="form-control"
            placeholder="EX- @abc"
            required
          />
          <div class="invalid-feedback">Please Enter username</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email : </label>
          <input
            type="email"
            name="email"
            class="form-control"
            placeholder="EX- abs@gmail.com"
            required
          />
          <div class="invalid-feedback">This field is required .</div>
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">password : </label>
          <input
            type="password"
            name="password"
            class="form-control"
            required
          />
          <div class="invalid-feedback">password</div>
        </div>
        <div class="d-flex justify-content-center">
        <button class="btn btn-outline-success ">Signup</button>
            </div>
    </form>
    </div>
  </div>
</div>
